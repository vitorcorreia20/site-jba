generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum PapelAdmin {
  MASTER
  DIRETORIA
  COMISSAO
}

// Usuário com acesso ao painel admin (diretoria / comissão)
model AdminUser {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  papel        PapelAdmin @default(COMISSAO)
  criadoEm     DateTime @default(now())
}

// Membro do capítulo: ativo, diretoria ou apenas histórico
enum TipoMembro {
  ATIVO
  DIRETORIA
}

model Membro {
  id              String     @id @default(cuid())
  idDemolay       String     @unique
  nome            String
  fotoUrl         String?
  tipo            TipoMembro
  cargoAtual      String? // ex: "1º Conselheiro", "Escrivão"
  historicoCargos String? // texto livre, um cargo por linha: "2023 - Escrivão\n2024 - Tesoureiro"
  ativo           Boolean    @default(true) // permite "desativar" sem apagar o histórico
  premios         Premio[]
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt
}

model Premio {
  id        String   @id @default(cuid())
  membroId  String
  membro    Membro   @relation(fields: [membroId], references: [id], onDelete: Cascade)
  imagemUrl String
  legenda   String?
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())

  @@index([membroId])
}

// Mestre Conselheiro histórico, para o Quadro de Lideranças
model MestreConselheiro {
  id        String   @id @default(cuid())
  nome      String
  fotoUrl   String?
  periodo   String // ex: "2023" ou "2023/2024"
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())
}

// Solicitação enviada pelo formulário "Quero fazer parte"
enum StatusAdmissao {
  PENDENTE
  EM_ANALISE
  APROVADO
  RECUSADO
}

model SolicitacaoAdmissao {
  id             String          @id @default(cuid())
  nomeCompleto   String
  dataNascimento DateTime
  email          String?         // legado nullable; novos cadastros null (contato via WhatsApp/telefone)
  telefone       String          // WhatsApp com DDD
  responsavel    String? // nome do responsável, se o candidato for menor
  cidade         String
  mensagem       String? // motivação / como conheceu o capítulo
  status         StatusAdmissao  @default(PENDENTE)
  notasComissao  String? // anotações internas da comissão de análise
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
}

// Fotos de ações do capítulo exibidas na Home
model FotoAcao {
  id            String        @id @default(cuid())
  url           String
  legenda       String?
  dataRealizada DateTime      @default(now())
  criadoEm      DateTime      @default(now())
  curtidas      CurtidaFoto[]
}

// Curtida pública por visitante anônimo (1 curtida por foto por visitante)
model CurtidaFoto {
  id          String   @id @default(cuid())
  fotoAcaoId  String
  fotoAcao    FotoAcao @relation(fields: [fotoAcaoId], references: [id], onDelete: Cascade)
  visitanteId String
  criadoEm    DateTime @default(now())

  @@unique([fotoAcaoId, visitanteId])
  @@index([fotoAcaoId])
  @@index([visitanteId])
}

// Mensagem enviada pelo formulário de Contato (nome/telefone/descricao)
model Contato {
  id         String   @id @default(cuid())
  nome       String
  telefone   String
  descricao  String?
  lido       Boolean  @default(false)
  realizado  Boolean  @default(false)
  criadoEm   DateTime @default(now())
}

// Trilha de auditoria: tudo que acontece no painel admin fica registrado.
// Ações como texto livre para não travar a evolução (ex: LOGIN, LOGIN_FALHA,
// CRIAR, EDITAR, REMOVER, ALTERAR_STATUS, UPLOAD).
model Auditoria {
  id         String   @id @default(cuid())
  atorId     String?
  atorNome   String?
  atorEmail  String?
  atorPapel  String?
  acao       String
  entidade   String
  entidadeId String?
  detalhe    String?
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([acao])
  @@index([entidade])
  @@index([atorEmail])
}
